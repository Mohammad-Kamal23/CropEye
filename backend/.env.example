# CropEye backend settings. Copy to .env and pass it to Docker (docker run --env-file backend/.env ...),
# or export the variables in your shell. Every value below is the default unless noted.

# Google Gemini key for the agronomy assistant (/chat and the advice in /detect). Leave empty to run without it.
GEMINI_API_KEY=

# Model files (not in the repository - see models/README.md)
YOLO_MODEL_PATH=models/best_yolo_s.onnx
CNN_MODEL_PATH=models/shufflenetv2_full_precision.onnx
# Optional indexed leaf database; the API works without it
INDEX_DB_PATH=INDEXED-DATABASE/leaf_index.pkl
INDEX_DB_MIN_SIM=0.65

# Detection settings (must match how the models were exported)
YOLO_IMG=640
YOLO_CONF=0.25
YOLO_IOU=0.65
CNN_INPUT_SIZE=224

# Server behaviour
# The server stops itself after IDLE_TIMEOUT_SEC without requests (useful on Cloud Run); set 0 for local work.
ALLOW_IDLE_EXIT=0
IDLE_TIMEOUT_SEC=900
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOW_ORIGINS=*
# Diagnostic routes (/debug/..., /docs, GPU checks) - keep 0 on any public server
ENABLE_DEBUG_ROUTES=0
DEBUG_MODE=0
